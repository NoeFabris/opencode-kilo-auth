{
  "name": "opencode-kilo-authentication",
  "version": "2.0.1",
  "description": "Kilo device auth plugin for OpenCode v2",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "type": "module",
  "license": "MIT",
  "author": "noefabris",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NoeFabris/opencode-kilo-auth.git"
  },
  "homepage": "https://github.com/NoeFabris/opencode-kilo-auth#readme",
  "bugs": {
    "url": "https://github.com/NoeFabris/opencode-kilo-auth/issues"
  },
  "keywords": [
    "opencode",
    "kilo",
    "kilocode",
    "oauth",
    "auth",
    "plugin"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "models": "node ./dist/scripts/fetch-models.js",
    "sync-models": "node ./dist/scripts/sync-models.js",
    "install:opencode": "node ./dist/scripts/install.js"
  },
  "dependencies": {
    "@opencode/plugin": "^2.1.4",
    "jsonc-parser": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.2",
    "typescript": "^5.0.0"
  }
}
